{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Multi User Chat",
  "version": "0.1.0",
  "identifier": "com.gorcly.multiuserchat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "多用户聊天系统",
        "width": 1000,
        "height": 720,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
